{
  "name": "louvorja-libras",
  "productName": "LouvorJA Libras",
  "version": "1.2.0",
  "description": "Avatar 3D de Libras integrado ao LouvorJA. Open source e gratuito para igrejas.",
  "private": true,
  "license": "LGPL-3.0-only",
  "author": "Comunidade LouvorJA Libras",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/fetch-vlibras-player.mts",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/fetch-vlibras-player.mts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "brand:build": "node scripts/brand/build-brand.mts",
    "brand:avatars": "node scripts/brand/capture-avatars.mts",
    "player:fetch": "node scripts/fetch-vlibras-player.mts",
    "libras:benchmark": "node scripts/libras/benchmark.mts",
    "libras:oracle": "node scripts/libras/oracle.mts",
    "mock:louvorja": "node scripts/mock-louvorja/index.mts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-country-flag-next": "^2.3.2",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vuetify": "^3.13.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.9.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "ws": "^8.21.3"
  }
}
