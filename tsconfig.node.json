{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "electron-vite/node"]
  },
  "include": [
    "electron/**/*",
    "src/types/**/*",
    "database/**/*",
    "scripts/**/*",
    "tests/unit/electron/**/*",
    "tests/integration/**/*",
    "tests/e2e/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
